[sub_resource type="GDScript" id="GDScript_lyw2l"]
script/source = "extends CharacterBody3D

# =========================
# VISUAL NODE
# =========================
@onready var visual = $AnimatedSprite3D

# =========================
# MOVEMENT
# =========================
@export var SPEED := 3.0

# DIRECTION
# 1 = LEFT
# 0 = RIGHT
@export var MOVE_DIRECTION := 1

# =========================
# FLOATING
# =========================
@export var FLOAT_AMOUNT := 0.15
@export var FLOAT_SPEED := 2.0

# =========================
# TILT
# =========================
@export var MAX_TILT := 10.0
@export var TILT_SMOOTHNESS := 4.0

# =========================
# SQUASH & STRETCH
# =========================
@export var STRETCH_AMOUNT := 0.05
@export var SQUASH_SPEED := 5.0

# =========================
# INTERNAL
# =========================
var time := 0.0
var base_scale := Vector3.ONE


func _ready() -> void:

	# IMPORTANT:
	# Save VISUAL scale, not CharacterBody scale
	base_scale = visual.scale


func _physics_process(delta: float) -> void:

	time += delta

	# =========================
	# LEFT / RIGHT ONLY
	# =========================
	var direction := Vector3.ZERO

	# LEFT
	if MOVE_DIRECTION == 1:
		direction = Vector3.LEFT

	# RIGHT
	else:
		direction = Vector3.RIGHT

	# =========================
	# MOVE
	# =========================
	position += direction * SPEED * delta

	# =========================
	# FLOATING
	# =========================
	position.y += sin(time * FLOAT_SPEED) * FLOAT_AMOUNT * delta

	# =========================
	# ROTATION
	# =========================
	var target_y_rotation = atan2(
		direction.x,
		direction.z
	)

	rotation.y = lerp_angle(
		rotation.y,
		target_y_rotation,
		4.0 * delta
	)

	# =========================
	# SIDE TILT
	# =========================
	var target_tilt = -direction.x * deg_to_rad(MAX_TILT)

	rotation.z = lerp(
		rotation.z,
		target_tilt,
		TILT_SMOOTHNESS * delta
	)

	# =========================
	# SQUASH & STRETCH
	# IMPORTANT:
	# Scale ONLY the visual node
	# =========================
	var squash_wave = sin(time * SQUASH_SPEED)

	visual.scale.x = lerp(
		visual.scale.x,
		base_scale.x + squash_wave * STRETCH_AMOUNT,
		6.0 * delta
	)

	visual.scale.y = lerp(
		visual.scale.y,
		base_scale.y - squash_wave * STRETCH_AMOUNT * 0.5,
		6.0 * delta
	)

	visual.scale.z = lerp(
		visual.scale.z,
		base_scale.z + squash_wave * STRETCH_AMOUNT,
		6.0 * delta
	)
"

