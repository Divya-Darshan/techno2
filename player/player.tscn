[sub_resource type="GDScript" id="GDScript_en3rn"]
resource_name = "camera_touch.gd"
script/source = "extends Control

signal look(delta: Vector2)

var finger := -1

func _gui_input(event):

	if event is InputEventScreenTouch:
		#print(\"TOUCH\")

		if event.pressed:
			finger = event.index
		elif event.index == finger:
			finger = -1


	elif event is InputEventScreenDrag:
		#print(\"DRAG\")

		if event.index == finger:
			emit_signal(\"look\", event.relative)
"

